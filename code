<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Gemini 4 · Model Lab 元素周期表合成实验室</title>
  <style>
    :root {
      --bg-page: #ffffff;
      --surface: #ffffff;
      --surface-subtle: #f8fafc;
      --surface-pill: #f1f5f9;
      --border-light: #e5e7eb;
      --border-med: #cbd5e1;
      --text-primary: #1f2937;
      --text-secondary: #6b7280;
      --text-muted: #9ca3af;
      --btn-dark: #1e293b;
      --btn-dark-hover: #0f172a;
      --shadow-card: 0 18px 45px -10px rgba(15, 23, 42, 0.09), 0 4px 16px -4px rgba(15, 23, 42, 0.04);
      --shadow-pill: 0 4px 20px rgba(15, 23, 42, 0.06);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Google Sans", "Segoe UI", Roboto, "PingFang SC", "Microsoft YaHei", sans-serif;
      background-color: var(--bg-page);
      color: var(--text-primary);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 36px 16px 48px;
      position: relative;
      overflow-x: hidden;
    }

    /* 顶部柔和蓝紫光晕（还原视频背景氛围） */
    .ambient-glow {
      position: fixed;
      top: -60px;
      left: 50%;
      transform: translateX(-50%);
      width: 680px;
      height: 360px;
      background: radial-gradient(ellipse at center, rgba(199, 210, 254, 0.65) 0%, rgba(224, 231, 255, 0.28) 42%, rgba(255, 255, 255, 0) 75%);
      pointer-events: none;
      z-index: 0;
      transition: background 0.8s ease;
    }

    .app-shell {
      width: 100%;
      max-width: 780px;
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    /* 顶部标题 */
    .hero-title {
      font-size: clamp(1.55rem, 3vw, 2.05rem);
      font-weight: 500;
      letter-spacing: -0.02em;
      color: #1f1f1f;
      margin-top: 22px;
      margin-bottom: 24px;
      text-align: center;
    }

    /* Ask Gemini 输入框胶囊 */
    .prompt-bar {
      width: 100%;
      max-width: 650px;
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(12px);
      border: 1px solid var(--border-light);
      border-radius: 9999px;
      padding: 8px 10px 8px 18px;
      display: flex;
      align-items: center;
      gap: 10px;
      box-shadow: var(--shadow-pill);
      transition: border-color 0.2s, box-shadow 0.2s;
      position: relative;
      z-index: 20;
    }

    .prompt-bar:focus-within {
      border-color: #c7d2fe;
      box-shadow: 0 8px 28px rgba(99, 102, 241, 0.1);
    }

    .plus-icon-btn {
      width: 28px;
      height: 28px;
      border: none;
      background: transparent;
      color: var(--text-secondary);
      font-size: 1.25rem;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      cursor: pointer;
    }
    .plus-icon-btn:hover { background: var(--surface-pill); color: var(--text-primary); }

    .prompt-input {
      flex: 1;
      border: none;
      outline: none;
      background: transparent;
      font-size: 0.95rem;
      color: var(--text-primary);
      min-width: 0;
    }
    .prompt-input::placeholder { color: #9ca3af; }

    /* 模型/物质选择下拉胶囊 (Hydrogen v / Neon v / H2O v) */
    .model-selector-wrap {
      position: relative;
    }

    .model-dropdown-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #f3f4f6;
      hover: #e5e7eb;
      border: 1px solid transparent;
      border-radius: 9999px;
      padding: 7px 14px;
      font-size: 0.85rem;
      font-weight: 500;
      color: #374151;
      cursor: pointer;
      transition: all 0.2s ease;
      white-space: nowrap;
    }
    .model-dropdown-btn:hover {
      background: #e5e7eb;
    }
    .model-dropdown-btn.open {
      background: #eef2ff;
      border-color: #c7d2fe;
      color: #1e1b4b;
    }
    .model-dropdown-btn svg {
      width: 14px;
      height: 14px;
      transition: transform 0.25s ease;
    }
    .model-dropdown-btn.open svg {
      transform: rotate(180deg);
    }

    /* 合成结果弹出提示气泡（还原视频 00:07 / 00:12 顶部右侧弹窗） */
    .brew-toast {
      position: absolute;
      top: calc(100% + 10px);
      right: 0;
      background: #ffffff;
      border: 1px solid var(--border-light);
      border-radius: 14px;
      padding: 9px 14px;
      box-shadow: 0 12px 30px rgba(15, 23, 42, 0.12);
      display: flex;
      align-items: center;
      gap: 10px;
      z-index: 40;
      opacity: 0;
      transform: translateY(-8px) scale(0.96);
      pointer-events: none;
      transition: all 0.28s cubic-bezier(0.16, 1, 0.3, 1);
      white-space: nowrap;
    }
    .brew-toast.show {
      opacity: 1;
      transform: translateY(0) scale(1);
      pointer-events: auto;
    }

    .toast-badge {
      width: 28px;
      height: 28px;
      border-radius: 7px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 0.78rem;
      border: 1.5px solid currentColor;
    }

    .toast-info {
      display: flex;
      flex-direction: column;
    }
    .toast-title {
      font-size: 0.86rem;
      font-weight: 600;
      color: #111827;
    }
    .toast-sub {
      font-size: 0.72rem;
      color: #6b7280;
    }

    /* Model Lab 主卡片 */
    .model-lab-card {
      width: 100%;
      margin-top: 14px;
      background: var(--surface);
      border: 1px solid var(--border-light);
      border-radius: 22px;
      padding: 16px 20px 20px;
      box-shadow: var(--shadow-card);
      transition: opacity 0.25s ease, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      transform-origin: top center;
    }

    .model-lab-card.hidden {
      display: none;
    }

    .lab-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 10px;
    }

    .lab-title {
      display: flex;
      align-items: center;
      gap: 7px;
      font-size: 0.88rem;
      font-weight: 600;
      color: #374151;
    }

    .lab-header-right {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .hover-readout {
      font-size: 0.76rem;
      color: var(--text-secondary);
      background: var(--surface-subtle);
      padding: 3px 10px;
      border-radius: 999px;
      border: 1px solid var(--border-light);
    }

    .close-lab-btn {
      width: 26px;
      height: 26px;
      border: none;
      background: transparent;
      color: #6b7280;
      font-size: 1.15rem;
      border-radius: 50%;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .close-lab-btn:hover { background: var(--surface-pill); color: #111827; }

    /* 元素周期表区域 */
    .ptable-wrapper {
      position: relative;
      width: 100%;
      overflow-x: auto;
      padding-bottom: 6px;
    }

    .ptable-grid {
      display: grid;
      grid-template-columns: repeat(18, minmax(32px, 1fr));
      gap: 4px;
      min-width: 630px;
      position: relative;
    }

    /* 周期表左上中空区的 Gemini 4 标题（完全还原视频位置） */
    .gemini-watermark {
      grid-column: 3 / 13;
      grid-row: 1 / 4;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      pointer-events: none;
      user-select: none;
      padding-top: 6px;
    }
    .gemini-watermark h2 {
      font-size: clamp(1.45rem, 2.6vw, 1.9rem);
      font-weight: 600;
      color: #1f2937;
      letter-spacing: -0.02em;
    }
    .gemini-watermark span {
      font-size: 0.72rem;
      color: #9ca3af;
      margin-top: 2px;
    }

    .el-tile {
      aspect-ratio: 1 / 1;
      border-radius: 7px;
      border: 1px solid #e5e7eb;
      background: #fafafa;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      user-select: none;
      transition: transform 0.14s ease, box-shadow 0.14s ease, background-color 0.14s ease, border-color 0.14s ease;
      position: relative;
    }

    .el-tile:hover {
      transform: translateY(-2px) scale(1.12);
      z-index: 10;
      box-shadow: 0 6px 14px rgba(15, 23, 42, 0.12);
      background: #ffffff;
    }

    .el-tile:active {
      transform: scale(0.95);
    }

    .el-sym {
      font-size: 0.76rem;
      font-weight: 600;
      line-height: 1;
    }

    /* 过渡金属默认精简小点点显示，悬浮或选中时显现符号（还原视频极简排布） */
    .el-tile.compact .el-sym {
      color: #9ca3af;
      font-weight: 500;
      font-size: 0.68rem;
    }
    .el-tile.compact:hover .el-sym,
    .el-tile.in-slot .el-sym {
      color: #1f2937;
      font-weight: 700;
      font-size: 0.76rem;
    }

    /* 元素分类淡彩描边（还原视频中的 C 淡紫、Ar/U/Pu 淡绿等视觉语言） */
    .cat-nonmetal {
      background: #f5f3ff;
      border-color: #d8b4fe;
      color: #6b21a8;
    }
    .cat-noble {
      background: #ecfdf5;
      border-color: #a7f3d0;
      color: #065f46;
    }
    .cat-alkali {
      background: #fef2f2;
      border-color: #fecaca;
      color: #991b1b;
    }
    .cat-alkaline {
      background: #fff7ed;
      border-color: #fed7aa;
      color: #9a3412;
    }
    .cat-halogen {
      background: #eff6ff;
      border-color: #bfdbfe;
      color: #1e40af;
    }
    .cat-metalloid {
      background: #f0fdfa;
      border-color: #99f6e4;
      color: #115e59;
    }
    .cat-post {
      background: #f8fafc;
      border-color: #cbd5e1;
      color: #334155;
    }
    .cat-transition {
      background: #f9fafb;
      border-color: #e5e7eb;
      color: #4b5563;
    }
    .cat-actinide {
      background: #f0fdf4;
      border-color: #86efac;
      color: #166534;
    }

    .el-tile.in-slot {
      box-shadow: 0 0 0 2px #6366f1;
    }

    .lan-act-spacer {
      grid-column: 1 / -1;
      height: 5px;
    }

    /* 底部合成台区域（锥形瓶 + 8槽位 + Heat + Brew） */
    .workbench {
      margin-top: 14px;
      padding-top: 14px;
      border-top: 1px solid #f1f5f9;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      flex-wrap: wrap;
    }

    /* 左侧动态锥形瓶容器 */
    .flask-stage {
      width: 92px;
      height: 112px;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .flask-svg {
      width: 86px;
      height: 106px;
      overflow: visible;
    }

    .flask-liquid {
      transition: fill 0.55s ease, transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
      transform-origin: bottom center;
    }

    /* 瓶内悬浮小徽章（还原视频 00:14 U & Pu 在液体中漂浮的效果） */
    .flask-floating-items {
      position: absolute;
      bottom: 14px;
      left: 50%;
      transform: translateX(-50%);
      width: 54px;
      height: 44px;
      display: flex;
      flex-wrap: wrap-reverse;
      align-items: center;
      justify-content: center;
      gap: 2px;
      pointer-events: none;
    }

    .mini-flask-pill {
      font-size: 0.56rem;
      font-weight: 700;
      padding: 1px 4px;
      border-radius: 4px;
      background: rgba(255, 255, 255, 0.88);
      border: 1px solid rgba(31, 41, 55, 0.35);
      color: #1f2937;
      animation: bobbing 2.2s ease-in-out infinite;
    }
    .mini-flask-pill:nth-child(even) {
      animation-delay: 0.6s;
    }

    @keyframes bobbing {
      0%, 100% { transform: translateY(0px) rotate(-3deg); }
      50% { transform: translateY(-4px) rotate(4deg); }
    }

    /* 瓶口烟雾与粒子层 */
    .flask-particles {
      position: absolute;
      inset: 0;
      pointer-events: none;
    }

    .particle-dot {
      position: absolute;
      border-radius: 50%;
      animation: riseUp 1.4s ease-out forwards;
    }

    @keyframes riseUp {
      0% { transform: translate(0, 0) scale(0.7); opacity: 0.9; }
      100% { transform: translate(var(--dx, 0px), var(--dy, -48px)) scale(1.6); opacity: 0; }
    }

    @keyframes flaskShake {
      0%, 100% { transform: rotate(0deg); }
      20% { transform: rotate(-3deg); }
      40% { transform: rotate(3deg); }
      60% { transform: rotate(-2deg); }
      80% { transform: rotate(2deg); }
    }
    .flask-stage.brewing .flask-svg {
      animation: flaskShake 0.45s ease-in-out infinite;
    }

    /* 中间控制区：8个槽位 + Heat 档位 */
    .controls-center {
      flex: 1;
      min-width: 260px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .slots-row {
      display: flex;
      align-items: center;
      gap: 7px;
      flex-wrap: wrap;
    }

    .slot-box {
      width: 34px;
      height: 34px;
      border-radius: 8px;
      border: 1.5px solid #cbd5e1;
      background: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.8rem;
      font-weight: 700;
      color: #1f2937;
      transition: all 0.18s ease;
      position: relative;
    }

    .slot-box.filled {
      cursor: pointer;
      animation: slotPop 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .slot-box.filled:hover {
      transform: scale(0.92);
      opacity: 0.8;
    }
    .slot-box.filled:hover::after {
      content: "×";
      position: absolute;
      inset: 0;
      background: rgba(15, 23, 42, 0.75);
      color: #fff;
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.9rem;
    }

    @keyframes slotPop {
      0% { transform: scale(0.5); opacity: 0; }
      100% { transform: scale(1); opacity: 1; }
    }

    .heat-row {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .heat-label {
      font-size: 0.84rem;
      font-weight: 500;
      color: #6b7280;
    }

    .heat-segmented {
      display: inline-flex;
      background: #f1f5f9;
      padding: 3px;
      border-radius: 9999px;
      border: 1px solid #e2e8f0;
    }

    .heat-btn {
      border: none;
      background: transparent;
      padding: 5px 14px;
      border-radius: 9999px;
      font-size: 0.8rem;
      font-weight: 500;
      color: #64748b;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .heat-btn.active {
      background: #ffffff;
      color: #0f172a;
      font-weight: 600;
      box-shadow: 0 2px 6px rgba(15, 23, 42, 0.08);
    }

    /* 右侧 Brew 按钮区 */
    .brew-action-col {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 8px;
    }

    .brew-btn {
      background: var(--btn-dark);
      color: #ffffff;
      border: none;
      border-radius: 9999px;
      padding: 11px 28px;
      font-size: 0.88rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
      box-shadow: 0 4px 12px rgba(15, 23, 42, 0.16);
      min-width: 108px;
    }

    .brew-btn:hover:not(:disabled) {
      background: var(--btn-dark-hover);
      transform: translateY(-1px);
    }

    .brew-btn:disabled {
      background: #475569;
      cursor: wait;
      animation: pulseBrew 0.9s infinite alternate;
    }

    @keyframes pulseBrew {
      from { opacity: 0.78; }
      to { opacity: 1; }
    }

    .clear-link {
      font-size: 0.74rem;
      color: #9ca3af;
      background: none;
      border: none;
      cursor: pointer;
      padding-right: 6px;
    }
    .clear-link:hover { color: #4b5563; text-decoration: underline; }

    /* 反应现象与新生成物质结果展示条 */
    .reaction-report {
      margin-top: 14px;
      padding: 11px 14px;
      border-radius: 12px;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      font-size: 0.82rem;
      transition: all 0.3s ease;
    }

    .report-main {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .report-eq {
      font-weight: 700;
      color: #1e293b;
      font-family: "Cambria Math", "Segoe UI", monospace;
      font-size: 0.88rem;
    }

    .report-phenom {
      color: #475569;
      line-height: 1.45;
    }

    /* 快捷配方体验胶囊 */
    .quick-recipes {
      margin-top: 14px;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px;
    }

    .recipe-chip {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 9999px;
      padding: 5px 12px;
      font-size: 0.76rem;
      color: #475569;
      cursor: pointer;
      transition: all 0.16s ease;
    }
    .recipe-chip:hover {
      background: #eef2ff;
      border-color: #c7d2fe;
      color: #3730a3;
    }

    /* 对话回复气泡（支持直接在 Ask Gemini 中提问合成物质） */
    .chat-reply-box {
      width: 100%;
      max-width: 650px;
      margin-top: 14px;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 16px;
      padding: 14px 18px;
      font-size: 0.88rem;
      line-height: 1.6;
      color: #334155;
      display: none;
    }
    .chat-reply-box.visible { display: block; }
  </style>
</head>
<body>

<div class="ambient-glow" id="ambientGlow"></div>

<div class="app-shell">
  <h1 class="hero-title">Where should we start?</h1>

  <!-- 顶部 Ask Gemini 输入栏 -->
  <div class="prompt-bar">
    <button class="plus-icon-btn" title="展开/收起 Model Lab" onclick="toggleLab()">+</button>
    <input
      type="text"
      id="promptInput"
      class="prompt-input"
      placeholder="Ask Gemini"
      onkeydown="handlePromptKey(event)"
    />
    <div class="model-selector-wrap">
      <button class="model-dropdown-btn open" id="modelDropdownBtn" onclick="toggleLab()">
        <span id="currentModelName">Hydrogen</span>
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M5 7.5L10 12.5L15 7.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <!-- 视频同款合成结果弹出卡片 -->
      <div class="brew-toast" id="brewToast">
        <div class="toast-badge" id="toastBadge">Ne</div>
        <div class="toast-info">
          <span class="toast-title" id="toastTitle">Gemini 4 Neon</span>
          <span class="toast-sub" id="toastSub">合成成功 · 氖气单质</span>
        </div>
      </div>
    </div>
  </div>

  <!-- + Model Lab 元素周期表反应卡片 -->
  <div class="model-lab-card" id="modelLabCard">
    <div class="lab-header">
      <div class="lab-title">
        <span>+</span>
        <span>Model lab</span>
      </div>
      <div class="lab-header-right">
        <span class="hover-readout" id="hoverReadout">点击元素加入反应槽（最多 8 个）</span>
        <button class="close-lab-btn" title="收起实验室" onclick="toggleLab()">×</button>
      </div>
    </div>

    <!-- 元素周期表网格 -->
    <div class="ptable-wrapper">
      <div class="ptable-grid" id="ptableGrid">
        <div class="gemini-watermark">
          <h2>Gemini 4</h2>
          <span id="formulaPreview">Select elements to synthesize</span>
        </div>
      </div>
    </div>

    <!-- 底部锥形瓶 + 8槽位 + Heat + Brew -->
    <div class="workbench">
      <!-- 左侧锥形瓶 -->
      <div class="flask-stage" id="flaskStage">
        <div class="flask-particles" id="flaskParticles"></div>
        <svg class="flask-svg" viewBox="0 0 100 120">
          <defs>
            <clipPath id="flaskClip">
              <path d="M38 14 L62 14 L62 42 L86 96 Q90 106 78 106 L22 106 Q10 106 14 96 L38 42 Z" />
            </clipPath>
          </defs>
          <!-- 液体填充（动态缩放高度与颜色） -->
          <g clip-path="url(#flaskClip)">
            <rect

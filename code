// ================= 3. 状态变量 =================
const MAX_SLOTS = 8;
let slots = []; // 存放元素符号数组，如 ['C', 'C']
let currentHeat = 'Low';
let isBrewing = false;
let toastTimer = null;

// ================= 4. 初始化周期表与槽位 =================
function init() {
  const grid = document.getElementById('ptableGrid');

  // 镧系锕系间隙占位
  const spacer = document.createElement('div');
  spacer.className = 'lan-act-spacer';
  spacer.style.gridRow = 8;
  grid.appendChild(spacer);

  ELEMENTS.forEach(el => {
    const [num, sym, zh, en, cat, row, col, , , compact] = el;
    const tile = document.createElement('div');
    tile.className = `el-tile cat-${cat} ${compact ? 'compact' : ''}`;
    tile.style.gridRow = row;
    tile.style.gridColumn = col;
    tile.dataset.sym = sym;

    tile.innerHTML = `<span class="el-sym">${compact ? '··' : sym}</span>`;

    tile.onmouseenter = () => {
      if (compact) tile.querySelector('.el-sym').textContent = sym;
      document.getElementById('hoverReadout').textContent = `${num} · ${sym} ${zh} (${en})`;
    };

    tile.onmouseleave = () => {
      if (compact && !slots.includes(sym)) {
        tile.querySelector('.el-sym').textContent = '··';
      }
    };

    tile.onclick = () => addElementToSlot(sym);
    grid.appendChild(tile);
  });

  renderSlots();
  updateFlaskVisuals();
}

function addElementToSlot(sym) {
  if (isBrewing) return;
  if (slots.length >= MAX_SLOTS) {
    // 槽位满时替换最后一个或轻晃提示
    slots.shift();
  }
  slots.push(sym);
  renderSlots();
  updateFlaskVisuals();
}

function removeSlotAt(idx) {
  if (isBrewing) return;
  slots.splice(idx, 1);
  renderSlots();
  updateFlaskVisuals();
}

function clearSlots() {
  if (isBrewing) return;
  slots = [];
  renderSlots();
  updateFlaskVisuals();
  document.getElementById('formulaPreview').textContent = 'Select elements to synthesize';
}

function renderSlots() {
  const row = document.getElementById('slotsRow');
  row.innerHTML = '';

  for (let i = 0; i < MAX_SLOTS; i++) {
    const box = document.createElement('div');
    const sym = slots[i];
    if (sym && EL_BY_SYM[sym]) {
      const cat = EL_BY_SYM[sym][4];
      box.className = `slot-box filled cat-${cat}`;
      box.textContent = sym;
      box.title = `点击移除 ${sym}`;
      box.onclick = () => removeSlotAt(i);
    } else {
      box.className = 'slot-box';
    }
    row.appendChild(box);
  }

  // 同步周期表高亮状态
  document.querySelectorAll('.el-tile').forEach(tile => {
    const s = tile.dataset.sym;
    const active = slots.includes(s);
    tile.classList.toggle('in-slot', active);
    if (tile.classList.contains('compact')) {
      tile.querySelector('.el-sym').textContent = active ? s : '··';
    }
  });

  // 更新 Gemini 4 下方实时化学式预览
  if (slots.length === 0) {
    document.getElementById('formulaPreview').textContent = 'Select elements to synthesize';
  } else {
    const counts = {};
    slots.forEach(s => { counts[s] = (counts[s] || 0) + 1; });
    const formula = Object.entries(counts)
      .map(([k, v]) => `${k}${v > 1 ? toSubscript(v) : ''}`)
      .join(' + ');
    document.getElementById('formulaPreview').textContent = `${formula} · ${currentHeat} Heat`;
  }
}

function setHeat(heat, btn) {
  if (isBrewing) return;
  currentHeat = heat;
  document.querySelectorAll('.heat-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  renderSlots();
}

// ================= 5. 锥形瓶液面与漂浮微粒动态渲染 =================
function updateFlaskVisuals(overrideColor = null) {
  const rect = document.getElementById('flaskLiquidRect');
  const floatWrap = document.getElementById('flaskFloatingItems');

  // 根据槽位数量计算液面高度 (空时 y=96 浅底，满 8 个时 y=46 高液位)
  const ratio = slots.length / MAX_SLOTS;
  const height = 14 + ratio * 52;
  const y = 108 - height;
  rect.setAttribute('y', y.toFixed(1));
  rect.setAttribute('height', height.toFixed(1));

  if (overrideColor) {
    rect.setAttribute('fill', overrideColor);
  } else if (slots.length === 0) {
    rect.setAttribute('fill', 'rgba(203, 213, 225, 0.28)');
  } else {
    // 取最新加入元素的代表色
    const lastSym = slots[slots.length - 1];
    const color = EL_BY_SYM[lastSym] ? EL_BY_SYM[lastSym][8] : 'rgba(99, 102, 241, 0.35)';
    rect.setAttribute('fill', color);
  }

  // 在瓶内液体中显示浮动的元素徽章
  floatWrap.innerHTML = slots
    .slice(-4)
    .map(s => `<span class="mini-flask-pill">${s}</span>`)
    .join('');
}

function emitFlaskParticles(type, color) {
  const container = document.getElementById('flaskParticles');
  const count = type === 'smoke' ? 14 : 10;

  for (let i = 0; i < count; i++) {
    setTimeout(() => {
      const dot = document.createElement('span');
      dot.className = 'particle-dot';
      const size = type === 'smoke' ? 8 + Math.random() * 10 : 4 + Math.random() * 5;
      dot.style.width = `${size}px`;
      dot.style.height = `${size}px`;
      dot.style.left = `${38 + Math.random() * 16}px`;
      dot.style.top = type === 'bubbles' ? `${68 + Math.random() * 20}px` : `${18 + Math.random() * 14}px`;
      dot.style.background = color;
      dot.style.setProperty('--dx', `${(Math.random() - 0.5) * 34}px`);
      dot.style.setProperty('--dy', `${-32 - Math.random() * 36}px`);
      container.appendChild(dot);
      setTimeout(() => dot.remove(), 1450);
    }, i * 65);
  }
}

// ================= 6. Brew 合成执行引擎 =================
function toSubscript(n) {
  const sub = ['₀','₁','₂','₃','₄','₅','₆','₇','₈','₉'];
  return String(n).split('').map(d => sub[Number(d)]).join('');
}

function gcd(a, b) {
  return b === 0 ? a : gcd(b, a % b);
}

function resolveReaction(inputSlots, heat) {
  if (inputSlots.length === 0) {
    return {
      badge: 'H',
      badgeBg: '#f3f4f6',
      badgeColor: '#374151',
      modelName: 'Hydrogen',
      toastTitle: 'Gemini 4 Hydrogen',
      toastSub: '默认基础模型 · 氢元素单质',
      liquidColor: 'rgba(56, 189, 248, 0.3)',
      particleType: 'bubbles',
      particleColor: '#93c5fd',
      eq: '¹H · 氢单质 (未添加新反应物)',
      phenom: '请点击周期表元素加入槽位后再点击 Brew 开始合成反应。'
    };
  }

  // 1) 单元素提纯 / 激发反应
  if (inputSlots.length === 1) {
    const el = EL_BY_SYM[inputSlots[0]];
    return {
      badge: el[1],
      badgeBg: '#eef2ff',
      badgeColor: '#3730a3',
      modelName: el[3],
      toastTitle: `Gemini 4 ${el[3]}`,
      toastSub: `${el[0]}号元素 · ${el[2]}单质激发态`,
      liquidColor: el[8],
      particleType: heat === 'High' ? 'sparks' : 'bubbles',
      particleColor: '#818cf8',
      eq: `${el[1]} (${el[2]}) — ${heat} 温区单质活化`,
      phenom: `在 ${heat} 热量条件下对 ${el[2]}(${el[1]}) 单质进行激发，瓶内呈现特征元素色泽与微粒跃迁现象。`
    };
  }

  // 2) 匹配预设经典反应与视频同款彩蛋
  const sortedKey = [...inputSlots].sort().join('+');
  let found = SPECIAL_REACTIONS.find(
    r => [...r.match].sort().join('+') === sortedKey && r.heats.includes(heat)
  );
  if (!found) {
    found = SPECIAL_REACTIONS.find(r => [...r.match].sort().join('+') === sortedKey);
  }
  if (found) return found;

  // 3) 通用多元素智能化学合成引擎
  const unique = [...new Set(inputSlots)];
  if (unique.length === 2) {
    const e1 = EL_BY_SYM[unique[0]];
    const e2 = EL_BY_SYM[unique[1]];
    const p1 = e1[7].find(v => v > 0);
    const n2 = e2[7].find(v => v < 0);
    const p2 = e2[7].find(v => v > 0);
    const n1 = e1[7].find(v => v < 0);

    let cat = null, ani = null, pv = 0, nv = 0;
    if (p1 && n2) { cat = e1; ani = e2; pv = p1; nv = Math.abs(n2); }
    else if (p2 && n1) { cat = e2; ani = e1; pv = p2; nv = Math.abs(n1); }

    if (cat && ani) {
      const d = gcd(pv, nv);
      const cCount = nv / d;
      const aCount = pv / d;
      const formula = `${cat[1]}${cCount > 1 ? toSubscript(cCount) : ''}${ani[1]}${aCount > 1 ? toSubscript(aCount) : ''}`;
      const zhName = `${ani[2]}化${cat[2]}`;
      return {
        badge: formula,
        badgeBg: '#ecfdf5',
        badgeColor: '#047857',
        modelName: `${formula} (${zhName})`,
        toastTitle: `合成新物质：${formula}`,
        toastSub: `${zhName} · 化合价自动配平`,
        liquidColor: heat === 'High' ? 'rgba(249, 115, 22, 0.45)' : 'rgba(16, 185, 129, 0.42)',
        particleType: heat === 'High' ? 'sparks' : 'bubbles',
        particleColor: heat === 'High' ? '#fb923c' : '#34d399',
        eq: `${cCount > 1 ? cCount : ''}${cat[1]} + ${aCount > 1 ? aCount : ''}${ani[1]}  === ${heat} ===  ${formula} (${zhName})`,
        phenom: `${cat[2]}(+${pv}) 与 ${ani[2]}(-${nv}) 发生电子转移化合，释放反应热并生成稳定的${zhName}晶体/分子。`
      };
    }
  }

  // 4) 同族或多元合金/复合体系
  const counts = {};
  inputSlots.forEach(s => { counts[s] = (counts[s] || 0) + 1; });
  const hybridFormula = Object.entries(counts)
    .map(([k, v]) => `${k}${v > 1 ? toSubscript(v) : ''}`)
    .join('');
  const names = unique.map(s => EL_BY_SYM[s][2]).join('·');

  return {
    badge: unique[0] + unique[1],
    badgeBg: '#f3e8ff',
    badgeColor: '#6b21a8',
    modelName: `${hybridFormula} 复合体`,
    toastTitle: `合成新物质：${hybridFormula}`,
    toastSub: `${names}多元复合体系`,
    liquidColor: 'rgba(139, 92, 246, 0.42)',
    particleType: heat === 'Low' ? 'bubbles' : 'smoke',
    particleColor: '#a78bfa',
    eq: `${inputSlots.join(' + ')}  === ${heat} 熔融复合 ===  ${hybridFormula}`,
    phenom: `在 ${heat} 温度场下，${names}原子间重新排布形成多元合金/复合相，伴随明显对流气泡与光热释放。`
  };
}

function startBrew() {
  if (isBrewing) return;
  isBrewing = true;

  const btn = document.getElementById('brewBtn');
  const stage = document.getElementById('flaskStage');
  btn.disabled = true;
  btn.textContent = 'Brewing...';
  stage.classList.add('brewing');

  const outcome = resolveReaction(slots, currentHeat);

  // 反应过程中的视觉现象
  updateFlaskVisuals(outcome.liquidColor);
  emitFlaskParticles(outcome.particleType, outcome.particleColor);

  setTimeout(() => {
    isBrewing = false;
    btn.disabled = false;
    btn.textContent = 'Brew';
    stage.classList.remove('brewing');

    // 更新顶部模型胶囊名称
    document.getElementById('currentModelName').textContent = outcome.modelName;

    // 弹出视频同款右上角通知气泡
    showBrewToast(outcome);

    // 更新底部反应方程式与现象报告
    document.getElementById('reportEq').textContent = outcome.eq;
    document.getElementById('reportPhenom').textContent = outcome.phenom;

    // 同步顶部光晕色调
    document.getElementById('ambientGlow').style.background =
      `radial-gradient(ellipse at center, ${outcome.liquidColor} 0%, rgba(224, 231, 255, 0.2) 45%, rgba(255, 255, 255, 0) 75%)`;
  }, 1050);
}

function showBrewToast(outcome) {
  const toast = document.getElementById('brewToast');
  const badge = document.getElementById('toastBadge');
  badge.textContent = outcome.badge;
  badge.style.backgroundColor = outcome.badgeBg;
  badge.style.color = outcome.badgeColor;

  document.getElementById('toastTitle').textContent = outcome.toastTitle;
  document.getElementById('toastSub').textContent = outcome.toastSub;

  toast.classList.add('show');
  if (toastTimer) clearTimeout(toastTimer);
  toastTimer = setTimeout(() => {
    toast.classList.remove('show');
  }, 4200);
}

function applyPreset(elList, heat) {
  if (isBrewing) return;
  slots = [...elList];
  currentHeat = heat;
  document.querySelectorAll('.heat-btn').forEach(b => {
    b.classList.toggle('active', b.dataset.heat === heat);
  });
  const card = document.getElementById('modelLabCard');
  if (card.classList.contains('hidden')) toggleLab();
  renderSlots();
  updateFlaskVisuals();
  startBrew();
}

function toggleLab() {
  const card = document.getElementById('modelLabCard');
  const btn = document.getElementById('modelDropdownBtn');
  const willOpen = card.classList.contains('hidden');
  card.classList.toggle('hidden', !willOpen);
  btn.classList.toggle('open', willOpen);
}

// 支持在 Ask Gemini 输入框中直接就当前合成物质提问
function handlePromptKey(e) {
  if (e.key !== 'Enter') return;
  const input = document.getElementById('promptInput');
  const q = input.value.trim();
  if (!q) return;

  const model = document.getElementById('currentModelName').textContent;
  const eq = document.getElementById('reportEq').textContent;
  const phenom = document.getElementById('reportPhenom').textContent;

  const box = document.getElementById('chatReplyBox');
  box.classList.add('visible');
  box.innerHTML = `
    <div style="font-size:0.76rem; color:#6366f1; font-weight:600; margin-bottom:4px;">
      ✦ Gemini 4 · 当前激活物质/模型：${model}
    </div>
    <div style="margin-bottom:6px; color:#111827;"><strong>你的提问：</strong>${q}</div>
    <div><strong>实验室反馈：</strong>当前反应体系为 <code>${eq}</code>。${phenom}</div>
  `;
  input.value = '';
}

init();
